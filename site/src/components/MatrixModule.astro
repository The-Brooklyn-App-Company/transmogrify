---
import Inline from './Inline.astro';

interface Table {
  caption: string;
  head: string[];
  rows: string[][];
}
interface Props {
  tables: Table[];
}
const { tables } = Astro.props;
---

<div class="matrix">
  {
    tables.map((table) => (
      <div class="table-wrap" tabindex="0" role="region" aria-label={table.caption}>
        <table>
          <caption>{table.caption}</caption>
          <thead>
            <tr>
              {table.head.map((cell) => (
                <th scope="col">{cell || <span class="sr-only">Capability</span>}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {table.rows.map(([first, ...rest]) => (
              <tr>
                <th scope="row"><Inline text={first} /></th>
                {rest.map((cell) => (
                  <td><Inline text={cell} /></td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ))
  }
</div>

<style>
  .matrix {
    display: grid;
    gap: var(--s-5);
  }

  /* Tables keep readable columns and scroll inside their own wrapper on
     narrow screens instead of widening the page. */
  .table-wrap {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-raised);
  }

  table {
    inline-size: 100%;
    min-inline-size: 34rem;
    font-size: var(--step--1);
    line-height: 1.5;
  }

  caption {
    text-align: start;
    padding: var(--s-3) var(--s-4);
    font-family: var(--mono);
    font-size: var(--step--2);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
    border-block-end: 1px solid var(--line);
  }

  th,
  td {
    text-align: start;
    vertical-align: top;
    padding: var(--s-3) var(--s-4);
    border-block-end: 1px solid var(--line);
  }

  tbody tr:last-child > * {
    border-block-end: 0;
  }

  thead th {
    font-family: var(--mono);
    font-weight: 600;
    color: var(--text);
    background: var(--bg-inset);
  }

  tbody th {
    font-weight: 600;
    color: var(--text);
    inline-size: 34%;
  }

  td {
    color: var(--muted);
  }

  td :global(code),
  th :global(code) {
    font-size: 0.92em;
    color: var(--text);
    background: var(--bg-inset);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 0.05em 0.32em;
  }
</style>
